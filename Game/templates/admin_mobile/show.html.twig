{% extends 'base.html.twig' %}

{% block title %}Mobile{% endblock %}

{% block body %}
    <h1>Mobile</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ mobile.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ mobile.name }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td><img src="{{ asset('uploads/mobiles/' ~ mobile.image) }}" alt="{{ mobile.name }}" height="80"></td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_mobile_index') }}">back to list</a>

    <a href="{{ path('app_admin_mobile_edit', {'id': mobile.id}) }}">edit</a>

    {{ include('admin_mobile/_delete_form.html.twig') }}
{% endblock %}
