{% extends 'base.html.twig' %}

{% block title %}Edit Mobile{% endblock %}

{% block body %}
<div class="admin">
    <h1 class="menu-title">Edit Mobile</h1>

    <div class="current-image">
        <img class="thumb thumb-mobile" src="{{ asset('uploads/mobiles/' ~ mobile.image) }}" alt="">
        <span>Current image. Upload a new file only if you want to replace it.</span>
    </div>

    {{ include('admin_mobile/_form.html.twig', {'button_label': 'Update'}) }}

    <div class="admin-actions">
        <a class="btn" href="{{ path('app_admin_mobile_index') }}">Back</a>
        {{ include('admin_mobile/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
