{% extends 'base.html.twig' %}

{% block title %}Mobiles{% endblock %}

{% block body %}
<div class="admin">
    <h1 class="menu-title">Mobiles</h1>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for mobile in mobiles %}
            <tr>
                <td><img class="thumb thumb-mobile" src="{{ asset('uploads/mobiles/' ~ mobile.image) }}" alt=""></td>
                <td>{{ mobile.name }}</td>
                <td>
                    <a class="btn btn-small" href="{{ path('app_admin_mobile_edit', {'id': mobile.id}) }}">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">No records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="admin-actions">
        <a class="btn" href="{{ path('app_admin_mobile_new') }}">Create new</a>
        <a class="btn" href="{{ path('app_menu_edit') }}">Back</a>
    </div>
</div>
{% endblock %}
