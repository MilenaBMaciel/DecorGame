{% extends 'base.html.twig' %}

{% block title %}Edit Furniture{% endblock %}

{% block body %}
<div class="admin">
    <h1 class="menu-title">Edit Furniture</h1>

    <div class="current-image">
        <img class="thumb thumb-furniture" src="{{ asset('uploads/furniture/' ~ furniture.image) }}" alt="">
        <span>Current image. Upload a new file only if you want to replace it.</span>
    </div>

    {{ include('admin_furniture/_form.html.twig', {'button_label': 'Update'}) }}

    <div class="admin-actions">
        <a class="btn" href="{{ path('app_admin_furniture_index') }}">Back</a>
        {{ include('admin_furniture/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
