{% extends 'base.html.twig' %}

{% block title %}Furniture{% endblock %}

{% block body %}
<div class="admin">
    <h1 class="menu-title">Furniture</h1>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for furniture in furniture_items %}
            <tr>
                <td><img class="thumb thumb-furniture" src="{{ asset('uploads/furniture/' ~ furniture.image) }}" alt=""></td>
                <td>{{ furniture.name }}</td>
                <td>
                    <a class="btn btn-small" href="{{ path('app_admin_furniture_edit', {'id': furniture.id}) }}">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">No records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="admin-actions">
        <a class="btn" href="{{ path('app_admin_furniture_new') }}">Create new</a>
        <a class="btn btn-yellow" href="{{ path('app_menu_edit') }}">Back</a>
    </div>
</div>
{% endblock %}
