{% extends 'base.html.twig' %}

{% block title %}Rooms{% endblock %}

{% block body %}
<div class="menu">
    <h1 class="menu-title">Choose a room</h1>

    <div class="room-list">
        {% for room in rooms %}
            <a class="room-card" href="{{ path('app_room_get', { id: room.id }) }}">
                <img src="{{ asset('uploads/rooms/' ~ room.image) }}" alt="">
                <span class="btn btn-full">{{ room.name }}</span>
            </a>
        {% endfor %}
    </div>

    <a class="btn btn-wide btn-yellow" href="{{ path('app_menu_main') }}">Back</a>
</div>
{% endblock %}
