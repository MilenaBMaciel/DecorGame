{# Fileira de slots do cômodo. active_slot: slot em edição (destacado e sem link) #}
<div class="slots-row">
    {% for slot in slots %}
        {% set active = active_slot is defined and active_slot.id == slot.id %}
        {% set tag = active_slot is defined ? 'div' : 'a' %}
        <{{ tag }} class="slot{{ active ? ' slot-active' : '' }}"
            {% if tag == 'a' %}href="{{ path('app_slot_edit', { id: slot.id }) }}"{% endif %}
            title="{{ slot.furniture ? slot.furniture.name : 'Empty' }}">
            {% if active %}
                {# Slot em edição: a imagem sempre existe, o JS troca (só prévia, não salva) #}
                <img {% if slot.furniture %}src="{{ asset('uploads/furniture/' ~ slot.furniture.image) }}"{% else %}hidden{% endif %} alt="" data-slot-preview-target="image">
            {% elseif slot.furniture %}
                <img src="{{ asset('uploads/furniture/' ~ slot.furniture.image) }}" alt="">
            {% endif %}
        </{{ tag }}>
    {% endfor %}
</div>
