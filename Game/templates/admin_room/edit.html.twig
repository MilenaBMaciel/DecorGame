{% extends 'base.html.twig' %}

{% block title %}Edit Room{% endblock %}

{% block body %}
<div class="admin">
    <h1 class="menu-title">Edit Room</h1>

    <div class="current-image">
        <img class="thumb thumb-room" src="{{ asset('uploads/rooms/' ~ room.image) }}" alt="">
        <span>Current image. Upload a new file only if you want to replace it.</span>
    </div>

    {{ include('admin_room/_form.html.twig', {'button_label': 'Update'}) }}

    <div class="admin-actions">
        <a class="btn" href="{{ path('app_admin_room_index') }}">Back</a>
        {{ include('admin_room/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
